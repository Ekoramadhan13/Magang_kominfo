<%- include('../partials/header') %>

<style>
    .timeline {
        position: relative;
        padding: 20px 0;
    }
    .timeline::before {
        content: '';
        position: absolute;
        top: 0;
        left: 20px;
        height: 100%;
        width: 2px;
        background: #e9ecef;
    }
    .timeline-item {
        position: relative;
        margin-bottom: 30px;
        padding-left: 50px;
    }
    .timeline-item::before {
        content: '';
        position: absolute;
        top: 5px;
        left: 14px;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: #fff;
        border: 3px solid #0d6efd;
        z-index: 1;
    }
    .timeline-item.verified::before { border-color: #198754; }
    .timeline-item.rejected::before { border-color: #dc3545; }
    .timeline-item.fixed::before { border-color: #0d6efd; }
    
    .timeline-card {
        border: none;
        border-radius: 12px;
        transition: transform 0.2s;
    }
    .timeline-card:hover {
        transform: translateX(5px);
    }
</style>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold mb-1">
                <i class="bi bi-clock-history text-primary me-2"></i>Riwayat Perubahan
            </h4>
            <p class="text-muted small mb-0">Lacak setiap langkah perbaikan dan verifikasi bug secara kronologis.</p>
        </div>
    </div>

    <div class="timeline">
        <% if (history.length > 0) { %>
            <% history.forEach(h => { %>
                <div class="timeline-item <%= h.status_baru %>">
                    <div class="card shadow-sm timeline-card">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <h6 class="fw-bold mb-1 text-dark">
                                        <a href="/bugs/<%= h.bug_id %>" class="text-decoration-none text-dark hover-primary">
                                            <%= h.bug_judul %>
                                        </a>
                                        <span class="badge bg-light text-muted border ms-2" style="font-weight: 500; font-size: 0.7rem;">
                                            #<%= h.bug_id %>
                                        </span>
                                    </h6>
                                    <div class="small text-muted d-flex align-items-center gap-2">
                                        <span class="badge bg-light text-primary border"><%= h.nama_aplikasi %></span>
                                        <span>•</span>
                                        <span><%= helpers.timeAgo(h.created_at) %></span>
                                    </div>
                                </div>
                                <div class="text-end">
                                    <div class="small fw-bold text-dark"><%= helpers.formatDateTime(h.created_at) %></div>
                                </div>
                            </div>

                            <div class="bg-light rounded p-2 d-flex align-items-center gap-2 mb-3">
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary py-1 px-2" style="font-size: 0.75rem;">
                                    <%= h.status_lama %>
                                </span>
                                <i class="bi bi-arrow-right text-muted"></i>
                                <span class="badge bg-<%= helpers.statusColor(h.status_baru) %> py-1 px-2" style="font-size: 0.75rem;">
                                    <%= helpers.capitalize(h.status_baru) %>
                                </span>
                                <% if (h.keterangan) { %>
                                    <span class="text-muted ms-2 small">
                                        <i class="bi bi-quote opacity-50"></i> <%= h.keterangan %>
                                    </span>
                                <% } %>
                            </div>

                            <div class="d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center">
                                    <div class="avatar-sm bg-primary text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px; font-weight: bold;">
                                        <%= h.user_nama.charAt(0).toUpperCase() %>
                                    </div>
                                    <div>
                                        <div class="small fw-bold text-dark mb-0"><%= h.user_nama %></div>
                                        <div class="text-muted" style="font-size: 0.7rem;">Melakukan perubahan status</div>
                                    </div>
                                </div>
                                <a href="/bugs/<%= h.bug_id %>" class="btn btn-sm btn-outline-primary px-3 rounded-pill">
                                    Lihat Bug <i class="bi bi-chevron-right small ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div class="text-center py-5">
                <div class="display-1 text-muted opacity-25 mb-3"><i class="bi bi-inbox"></i></div>
                <h5 class="text-muted">Belum ada riwayat aktivitas</h5>
                <p class="text-muted small">Semua perubahan status bug akan muncul di sini.</p>
            </div>
        <% } %>
    </div>
</div>

<%- include('../partials/footer') %>

