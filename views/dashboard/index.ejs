<%- include('../partials/header') %>

  <!-- ── HEADER SELAMAT DATANG ──────────────────────────────────────────────── -->
  <div class="card border-0 shadow-sm mb-4 overflow-hidden"
       style="border-radius:12px;background:linear-gradient(135deg,#1e1e2f 0%,#2d2d44 100%);">
    <div class="card-body p-4 d-flex justify-content-between align-items-center">
      <div>
        <h4 class="fw-bold mb-1 text-white">
          <i class="bi bi-person-badge text-primary"></i>
          Dashboard <%= helpers.capitalize(user.role.replace(/_/g, ' ')) %>
        </h4>
        <p class="text-white-50 mb-0">
          Selamat datang, <strong class="text-white"><%= user.nama %></strong>.
          Ini ringkasan aktivitas <%= user.role==='admin' ? 'sistem' : 'Anda' %>.
        </p>
      </div>
      <div class="text-end d-none d-md-block">
        <span class="badge bg-white text-dark border p-2">
          <i class="bi bi-calendar3 me-1"></i>
          <%= new Date().toLocaleDateString('id-ID',{weekday:'long',year:'numeric',month:'long',day:'numeric'}) %>
        </span>
      </div>
    </div>
  </div>

  <!-- ── TUGAS & NOTIFIKASI AKTIF (Mockup Kuning) ────────────────────────── -->
  <% if (pendingTaskDetails.length > 0) { %>
  <div class="card shadow-sm mb-4 border-0" style="border-radius: 12px; overflow: hidden;">
    <div class="card-header border-0 py-3 d-flex justify-content-between align-items-center" 
         style="background-color: #ffc107;">
      <h6 class="fw-bold mb-0 text-dark">
        <i class="bi bi-bell-fill me-1"></i> Tugas & Notifikasi
        <span class="badge bg-dark rounded-pill ms-1" style="font-size: 0.75rem;"><%= pendingTasksCount %></span>
      </h6>
    </div>
    <div class="list-group list-group-flush">
      <% pendingTaskDetails.forEach(task => { %>
      <a href="<%= task.notifId ? '/notifications/' + task.notifId + '/read' : task.link %>" 
         class="list-group-item list-group-item-action py-3 px-4 d-flex align-items-center gap-3">
        <div class="bg-light p-2 rounded-circle d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
          <i class="bi bi-<%= task.type === 'bug' ? 'bug-fill text-danger' : (task.type === 'notif' ? 'info-circle-fill text-info' : 'grid-fill text-primary') %> fs-5"></i>
        </div>
        <div class="flex-grow-1">
          <div class="fw-bold text-dark" style="font-size: 0.95rem;"><%= task.title %></div>
          <div class="text-muted small">
            <%= task.type === 'bug' ? 'Klik untuk lihat detail bug' : 'Klik untuk lihat detail tugas' %>
          </div>
        </div>
        <div class="text-muted">
          <i class="bi bi-arrow-right-circle fs-5"></i>
        </div>
      </a>
      <% }) %>
    </div>
  </div>
  <% } else { %>
  <div id="all-tasks-done" class="card shadow-sm mb-4 border-0" style="border-radius: 12px; background-color: #f8f9fa;">
    <div class="card-body py-4 text-center">
      <div class="text-success fs-1 mb-2"><i class="bi bi-check2-all"></i></div>
      <h6 class="fw-bold text-dark mb-1">Semua Tugas Selesai!</h6>
      <p class="text-muted small mb-0">Tidak ada tugas tertunda untuk role Anda saat ini.</p>
    </div>
  </div>
  <% } %>

  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>
  <script>
    // Efek Petasan (Confetti) hanya saat login awal atau pindah role
    const currentRole = "<%= user.role %>";
    if (sessionStorage.getItem('last_active_role') !== currentRole) {
      const duration = 3 * 1000;
      const animationEnd = Date.now() + duration;
      const defaults = { startVelocity: 30, spread: 360, ticks: 60, zIndex: 0 };

      function randomInRange(min, max) {
        return Math.random() * (max - min) + min;
      }

      const interval = setInterval(function() {
        const timeLeft = animationEnd - Date.now();
        if (timeLeft <= 0) return clearInterval(interval);

        const particleCount = 50 * (timeLeft / duration);
        confetti({ ...defaults, particleCount, origin: { x: randomInRange(0.1, 0.3), y: Math.random() - 0.2 } });
        confetti({ ...defaults, particleCount, origin: { x: randomInRange(0.7, 0.9), y: Math.random() - 0.2 } });
      }, 250);

      // Simpan role saat ini agar tidak muncul lagi kecuali pindah role
      sessionStorage.setItem('last_active_role', currentRole);
    }

    // Sembunyikan pesan "Semua Tugas Selesai" setelah 5 detik
    const taskDoneCard = document.getElementById('all-tasks-done');
    if (taskDoneCard) {
      setTimeout(() => {
        taskDoneCard.style.transition = 'opacity 1s ease, transform 1s ease';
        taskDoneCard.style.opacity = '0';
        taskDoneCard.style.transform = 'translateY(-20px)';
        setTimeout(() => taskDoneCard.style.display = 'none', 1000);
      }, 5000);
    }
  </script>

  <!-- ── STATISTIK BUG ──────────────────────────────────────────────────────── -->
  <div class="row g-3 mb-4">
    <div class="<%= ['admin','tim_leader','ketua_tester','business_analyst'].includes(user.role) ? 'col-md-7' : 'col-12' %>">
      <div class="row g-2 row-cols-3 row-cols-md-6">
        <% [
          { label:'Open',     val:bugStats.open,        color:'danger',    icon:'exclamation-circle' },
          { label:'Progress', val:bugStats.in_progress, color:'warning',   icon:'arrow-repeat' },
          { label:'Fixed',    val:bugStats.fixed,       color:'primary',   icon:'check2-square' },
          { label:'Verified', val:bugStats.verified,    color:'success',   icon:'patch-check' },
          { label:'Closed',   val:bugStats.closed,      color:'secondary', icon:'journal-check' },
          { label:'Rejected', val:bugStats.rejected,    color:'dark',      icon:'x-circle' }
        ].forEach(s => { %>
        <div class="col">
          <div class="card border-0 bg-<%= s.color %> text-white shadow-sm card-hover h-100">
            <div class="card-body text-center py-2 px-1">
              <i class="bi bi-<%= s.icon %> fs-4"></i>
              <h5 class="fw-bold mt-1 mb-0"><%= s.val || 0 %></h5>
              <div class="small opacity-75" style="font-size:0.7rem;"><%= s.label %></div>
            </div>
          </div>
        </div>
        <% }) %>
      </div>
    </div>

    <% if (['admin','tim_leader','ketua_tester','business_analyst'].includes(user.role)) { %>
    <div class="col-md-5">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body p-3">
          <h6 class="fw-bold mb-3"><i class="bi bi-grid-fill text-muted me-1"></i> Status Aplikasi</h6>
          <div class="row g-2">
            <% [
              { label:'Total',   val:appStats.total,   cls:'secondary' },
              { label:'Testing', val:appStats.testing, cls:'warning'   },
              { label:'Selesai', val:appStats.selesai, cls:'success'   }
            ].forEach(s => { %>
            <div class="col-4">
              <div class="p-2 border rounded text-center">
                <div class="h5 fw-bold mb-0 text-<%= s.cls %>"><%= s.val || 0 %></div>
                <div class="small text-muted"><%= s.label %></div>
              </div>
            </div>
            <% }) %>
          </div>
        </div>
      </div>
    </div>
    <% } %>
  </div>

  <!-- ── BUG TERBARU & APLIKASI TERBARU ─────────────────────────────────────── -->
  <div class="row g-4 mb-4">

  <!-- ── BAGIAN BUG (Terbaru vs Riwayat) ───────────────────────────────────── -->
  <div class="row g-4 mb-4">
    <div class="col-12">
      <div class="card shadow-sm border-0" style="border-radius:12px;">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
          <div class="d-flex align-items-center gap-2">
            <h6 class="fw-bold mb-0 text-primary me-2">
              <i class="bi bi-bug-fill me-1"></i> Data Bug
            </h6>
            <div class="btn-group p-1 bg-light" style="border-radius: 10px;">
              <button type="button" class="btn btn-sm btn-primary px-3 py-2" id="btnBugTerbaru" onclick="toggleBug('terbaru')" style="border-radius: 8px;">
                <i class="bi bi-lightning-fill me-1"></i> Bug Terbaru
              </button>
              <button type="button" class="btn btn-sm text-secondary px-3 py-2" id="btnBugRiwayat" onclick="toggleBug('riwayat')" style="border-radius: 8px;">
                <i class="bi bi-clock-history me-1"></i> Riwayat Bug
              </button>
            </div>
          </div>
          <a href="/bugs" class="text-primary text-decoration-none small fw-bold">
            <i class="bi bi-list-task"></i> Lihat Semua
          </a>
        </div>
        
        <!-- Table Bug Terbaru -->
        <div class="card-body p-0" id="boxBugTerbaru">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light" style="font-size:0.75rem; color: #6c757d;">
                <tr class="text-uppercase">
                  <th class="ps-4">Judul Bug</th>
                  <th>Aplikasi</th>
                  <th>Use Case</th>
                  <th>Kategori</th>
                  <th>Status</th>
                  <th class="text-end pe-4"></th>
                </tr>
              </thead>
              <tbody>
                <% recentBugs.forEach(bug => { %>
                <tr>
                  <td class="ps-4 py-3">
                    <div class="fw-bold text-dark mb-0" style="font-size: 1rem;"><%= bug.judul %></div>
                    <small class="text-muted">Oleh <%= bug.tester_nama %> • <%= helpers.formatDate(bug.created_at, 'D MMM') %></small>
                  </td>
                  <td>
                    <span class="badge bg-white text-dark border px-3 py-2" style="font-size: 0.8rem; border-radius: 8px; font-weight: 600;">
                      <%= bug.nama_aplikasi %>
                    </span>
                  </td>
                  <td><span class="text-secondary small"><%= bug.use_case_judul || '-' %></span></td>
                  <td><span class="text-muted small">-</span></td>
                  <td>
                    <span class="badge bg-<%= helpers.bugStatusColor(bug.status) %> px-3 py-2" style="font-size: 0.8rem; border-radius: 20px; font-weight: 600;">
                      <%= helpers.bugStatusLabel(bug.status) %>
                    </span>
                  </td>
                  <td class="text-end pe-4">
                    <a href="/bugs/<%= bug.id %>" class="btn btn-outline-secondary btn-sm rounded-circle p-0" style="width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center;">
                      <i class="bi bi-chevron-right"></i>
                    </a>
                  </td>
                </tr>
                <% }) %>
                <% if (recentBugs.length === 0) { %>
                <tr><td colspan="6" class="text-center text-muted py-5">Belum ada bug aktif</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Table Bug Riwayat -->
        <div class="card-body p-0 d-none" id="boxBugRiwayat">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light" style="font-size:0.75rem; color: #6c757d;">
                <tr class="text-uppercase">
                  <th class="ps-4">Judul Bug</th>
                  <th>Aplikasi</th>
                  <th>Kategori</th>
                  <th>Status</th>
                  <th class="text-end pe-4"></th>
                </tr>
              </thead>
              <tbody>
                <% oldBugs.forEach(bug => { %>
                <tr>
                  <td class="ps-4 py-3">
                    <div class="fw-bold text-dark mb-0"><%= bug.judul %></div>
                    <small class="text-muted">Selesai pada <%= helpers.formatDate(bug.updated_at, 'D MMM YYYY') %></small>
                  </td>
                  <td>
                    <span class="badge bg-white text-dark border px-3 py-2" style="font-size: 0.75rem; border-radius: 8px;">
                      <%= bug.nama_aplikasi %>
                    </span>
                  </td>
                  <td>
                    <% let catColor = helpers.bugStatusColor(bug.status); %>
                    <span class="badge px-3 py-2 border" style="
                        font-size: 0.75rem; border-radius: 8px; font-weight: 600;
                        background-color: var(--bs-<%= catColor %>-bg-subtle);
                        color: var(--bs-<%= catColor %>-text-emphasis);
                        border-color: var(--bs-<%= catColor %>-border-subtle);">
                      <%= helpers.bugOutcomeLabel(bug.status) %>
                    </span>
                  </td>
                  <td>
                    <span class="badge bg-<%= helpers.bugStatusColor(bug.status) %> px-3 py-2" style="font-size: 0.75rem; border-radius: 20px;">
                      <%= helpers.bugStatusLabel(bug.status) %>
                    </span>
                  </td>
                  <td class="text-end pe-4">
                    <a href="/bugs/<%= bug.id %>" class="btn btn-outline-secondary btn-sm rounded-circle p-0" style="width: 30px; height: 30px; display: inline-flex; align-items: center; justify-content: center;">
                      <i class="bi bi-chevron-right"></i>
                    </a>
                  </td>
                </tr>
                <% }) %>
                <% if (oldBugs.length === 0) { %>
                <tr><td colspan="5" class="text-center text-muted py-5">Belum ada riwayat bug</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ── BAGIAN APLIKASI (Terbaru vs Riwayat) ───────────────────────────────── -->
  <div class="row g-4 mb-4">
    <div class="col-12">
      <div class="card shadow-sm border-0" style="border-radius:12px;">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
          <div class="d-flex align-items-center gap-2">
            <h6 class="fw-bold mb-0 text-primary me-2">
              <i class="bi bi-grid-fill me-1"></i> Data Aplikasi
            </h6>
            <div class="btn-group p-1 bg-light" style="border-radius: 10px;">
              <button type="button" class="btn btn-sm btn-primary px-3 py-2" id="btnAppTerbaru" onclick="toggleApp('terbaru')" style="border-radius: 8px;">
                <i class="bi bi-plus-circle-fill me-1"></i> Aplikasi Terbaru
              </button>
              <button type="button" class="btn btn-sm text-secondary px-3 py-2" id="btnAppRiwayat" onclick="toggleApp('riwayat')" style="border-radius: 8px;">
                <i class="bi bi-archive-fill me-1"></i> Riwayat Aplikasi
              </button>
            </div>
          </div>
          <a href="/applications" class="text-primary text-decoration-none small fw-bold">
            <i class="bi bi-list-task"></i> Lihat Semua
          </a>
        </div>

        <!-- Table App Terbaru -->
        <div class="card-body p-0" id="boxAppTerbaru">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light" style="font-size:0.75rem; color: #6c757d;">
                <tr class="text-uppercase">
                  <th class="ps-4">Nama Aplikasi</th>
                  <th>Tim Leader</th>
                  <th>Deadline</th>
                  <th>Status</th>
                  <th class="text-end pe-4"></th>
                </tr>
              </thead>
              <tbody>
                <% recentApps.forEach(app => { %>
                <tr>
                  <td class="ps-4 py-3">
                    <div class="fw-bold text-dark mb-0"><%= app.nama_aplikasi %></div>
                    <small class="text-muted">Versi <%= app.versi || '-' %></small>
                  </td>
                  <td><span class="text-secondary small"><%= app.leader_nama || '-' %></span></td>
                  <td><span class="text-secondary small"><%= helpers.formatDate(app.tanggal_deadline) %></span></td>
                  <td>
                    <span class="badge bg-<%= helpers.appStatusColor(app.status) %>-subtle text-<%= helpers.appStatusColor(app.status) %> border border-<%= helpers.appStatusColor(app.status) %> px-3 py-1" style="font-size:0.75rem; border-radius: 8px;">
                      <%= helpers.capitalize(app.status) %>
                    </span>
                  </td>
                  <td class="text-end pe-4">
                    <a href="/applications/<%= app.id %>" class="btn btn-outline-secondary btn-sm rounded-circle p-0" style="width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center;">
                      <i class="bi bi-chevron-right"></i>
                    </a>
                  </td>
                </tr>
                <% }) %>
                <% if (recentApps.length === 0) { %>
                <tr><td colspan="5" class="text-center text-muted py-5">Belum ada aplikasi aktif</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Table App Riwayat -->
        <div class="card-body p-0 d-none" id="boxAppRiwayat">
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead class="table-light" style="font-size:0.75rem; color: #6c757d;">
                <tr class="text-uppercase">
                  <th class="ps-4">Nama Aplikasi</th>
                  <th>Tim Leader</th>
                  <th>Selesai Pada</th>
                  <th>Status</th>
                  <th class="text-end pe-4"></th>
                </tr>
              </thead>
              <tbody>
                <% oldApps.forEach(app => { %>
                <tr>
                  <td class="ps-4 py-3">
                    <div class="fw-bold text-dark mb-0"><%= app.nama_aplikasi %></div>
                    <small class="text-muted">Versi <%= app.versi || '-' %></small>
                  </td>
                  <td><span class="text-secondary small"><%= app.leader_nama || '-' %></span></td>
                  <td><span class="text-secondary small"><%= helpers.formatDate(app.updated_at || app.tanggal_deadline) %></span></td>
                  <td>
                    <span class="badge bg-success-subtle text-success border border-success px-3 py-1" style="font-size:0.75rem; border-radius: 8px;">
                      Selesai
                    </span>
                  </td>
                  <td class="text-end pe-4">
                    <a href="/applications/<%= app.id %>" class="btn btn-outline-secondary btn-sm rounded-circle p-0" style="width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center;">
                      <i class="bi bi-chevron-right"></i>
                    </a>
                  </td>
                </tr>
                <% }) %>
                <% if (oldApps.length === 0) { %>
                <tr><td colspan="5" class="text-center text-muted py-5">Belum ada riwayat aplikasi</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ── SCRIPTS TOGGLE ─────────────────────────────────────────────────────── -->
  <script>
    function toggleBug(type) {
      const btnT = document.getElementById('btnBugTerbaru');
      const btnR = document.getElementById('btnBugRiwayat');
      const boxT = document.getElementById('boxBugTerbaru');
      const boxR = document.getElementById('boxBugRiwayat');

      if (type === 'terbaru') {
        btnT.classList.add('btn-primary'); btnT.classList.remove('text-secondary');
        btnR.classList.remove('btn-primary'); btnR.classList.add('text-secondary');
        boxT.classList.remove('d-none');
        boxR.classList.add('d-none');
      } else {
        btnR.classList.add('btn-primary'); btnR.classList.remove('text-secondary');
        btnT.classList.remove('btn-primary'); btnT.classList.add('text-secondary');
        boxR.classList.remove('d-none');
        boxT.classList.add('d-none');
      }
    }

    function toggleApp(type) {
      const btnT = document.getElementById('btnAppTerbaru');
      const btnR = document.getElementById('btnAppRiwayat');
      const boxT = document.getElementById('boxAppTerbaru');
      const boxR = document.getElementById('boxAppRiwayat');

      if (type === 'terbaru') {
        btnT.classList.add('btn-primary'); btnT.classList.remove('text-secondary');
        btnR.classList.remove('btn-primary'); btnR.classList.add('text-secondary');
        boxT.classList.remove('d-none');
        boxR.classList.add('d-none');
      } else {
        btnR.classList.add('btn-primary'); btnR.classList.remove('text-secondary');
        btnT.classList.remove('btn-primary'); btnT.classList.add('text-secondary');
        boxR.classList.remove('d-none');
        boxT.classList.add('d-none');
      }
    }
  </script>


  </div>

<%- include('../partials/footer') %>