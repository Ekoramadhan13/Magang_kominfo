<%- include('../partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0"><i class="bi bi-bell text-primary me-2"></i>Semua Notifikasi</h4>
    <% if (notifications.length > 0) { %>
    <form action="/notifications/mark-all-read" method="POST">
        <button type="submit" class="btn btn-sm btn-outline-primary">
            <i class="bi bi-check2-all"></i> Tandai Semua Dibaca
        </button>
    </form>
    <% } %>
</div>

<div class="row">
    <div class="col-md-8 mx-auto">
        <div class="card shadow-sm border-0" style="border-radius: 15px; overflow: hidden;">
            <div class="list-group list-group-flush">
                <% if (notifications.length === 0) { %>
                    <div class="text-center py-5">
                        <i class="bi bi-bell-slash fs-1 text-muted mb-3 d-block"></i>
                        <h5 class="text-muted">Belum ada notifikasi</h5>
                        <p class="text-muted small">Anda akan menerima pemberitahuan di sini saat ada tugas atau bug baru.</p>
                        <a href="/dashboard" class="btn btn-primary mt-2">Kembali ke Dashboard</a>
                    </div>
                <% } else { %>
                    <% notifications.forEach(notif => { %>
                        <a href="/notifications/<%= notif.id %>/read" 
                           class="list-group-item list-group-item-action p-4 <%= notif.is_read ? 'bg-white' : 'bg-primary bg-opacity-10 border-start border-4 border-primary' %>">
                            <div class="d-flex w-100 justify-content-between align-items-start">
                                <div class="d-flex gap-3">
                                    <div class="bg-<%= notif.is_read ? 'light' : 'primary' %> p-3 rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                        <i class="bi bi-<%= notif.is_read ? 'envelope-open' : 'envelope-fill' %> <%= notif.is_read ? 'text-muted' : 'text-white' %> fs-5"></i>
                                    </div>
                                    <div>
                                        <h6 class="mb-1 fw-bold <%= notif.is_read ? 'text-muted' : 'text-dark' %>"><%= notif.message %></h6>
                                        <p class="mb-1 text-muted small">Klik untuk melihat detail tugas.</p>
                                        <small class="text-muted"><%= helpers.formatDateTime(notif.created_at) %></small>
                                    </div>
                                </div>
                                <% if (!notif.is_read) { %>
                                    <span class="badge bg-primary rounded-pill">Baru</span>
                                <% } %>
                            </div>
                        </a>
                    <% }) %>
                <% } %>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
